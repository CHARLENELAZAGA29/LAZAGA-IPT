@page "/..."
@rendermode InteractiveServer

<div class="text-center list-unstyled" style="padding-top:20px;">
    <div style="padding: 50px; border-radius: 20px; margin-top: 40px;
                background: linear-gradient(135deg, #fbc2eb, #a6c1ee); color:#333;">
        <h1 style="font-family:'Arial Black', Arial, sans-serif;
                   font-size:2.8rem;
                   font-weight:900;
                   letter-spacing:2px;
