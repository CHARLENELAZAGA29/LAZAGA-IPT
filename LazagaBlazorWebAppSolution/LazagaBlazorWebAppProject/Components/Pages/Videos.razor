@page "/Videos"
@rendermode InteractiveServer

<h1>Videos</h1>

<!-- Favourite Section -->
<div style="background-color:cornflowerblue; color:white; padding:20px; border-radius:10px;
            display:flex; align-items:center; justify-content:space-between; width:400px;">
    <img src="image/ProfileInfo.jpg"
         style="width:60px; height:60px; border-radius:50%; border:2px solid white;" />

    <div style="flex-grow:1; text-align:center;">
        <p style="margin:0; font-size:1.2rem;"></p>
    </div>

    <button class="btn btn-primary" @onclick="toggle">Show Videos</button>
</div>

@if (showVideo)
{
    <div style="margin-top:20px;">
        <video width="640" height="360" controls>
            <source src="videos/Vid1.mp4" type="video/mp4" />
            Your browser does not support the video tag.
        </video>
    </div>
    <div style="margin-top:20px;">
        <video width="640" height="360" controls>
            <source src="videos/Vid2.mp4" type="video/mp4" />
            Your browser does not support the video tag.
        </video>
    </div>
    <div style="margin-top:20px;">
        <video width="640" height="360" controls>
            <source src="videos/Vid3.mp4" type="video/mp4" />
            Your browser does not support the video tag.
        </video>
    </div>
}

@code {
    private bool showVideo = false;

    private void toggle()
    {
        showVideo = !showVideo;
    }
}
