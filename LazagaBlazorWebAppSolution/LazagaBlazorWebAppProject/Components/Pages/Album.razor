@page "/Album"
@rendermode InteractiveServer

<h1>Album</h1>

<!-- Favourite Section -->
<div style="background-color:cornflowerblue; color:white; padding:20px; border-radius:10px;
            display:flex; align-items:center; justify-content:space-between; width:400px;">
    <img src="image/ALBUM1.jpg"
         style="width:60px; height:60px; border-radius:50%; border:2px solid white;" />

    <div style="flex-grow:1; text-align:center;">
        <p style="margin:0; font-size:1.2rem;">FAVOURITE</p>
    </div>

    <button class="btn btn-primary" @onclick="ToggleFavourite">...</button>
</div>

@if (showFavourite)
{
    <div style="display:flex; flex-wrap:wrap; gap:20px; margin-top:20px; justify-content:center;">
        <!-- Favourite Images -->
        <img src="/image/ALBUM1.jpg" style="width:200px; height:200px; object-fit:cover; border-radius:10px;" />
        <img src="/image/FAV1.jpg" style="width:200px; height:200px; object-fit:cover; border-radius:10px;" />
        <img src="/image/ALBUM3.jpg" style="width:200px; height:200px; object-fit:cover; border-radius:10px;" />
    </div>
}

<!-- Fam Section -->
<div style="background-color:darkseagreen; color:white; padding:20px; border-radius:10px;
            display:flex; align-items:center; justify-content:space-between; width:400px; margin-top:20px;">
    <img src="image/ALBUM6.jpg"
         style="width:60px; height:60px; border-radius:50%; border:2px solid white;" />

    <div style="flex-grow:1; text-align:center;">
        <p style="margin:0; font-size:1.2rem;">FAM</p>
    </div>

    <button class="btn btn-primary" @onclick="ToggleFam">...</button>
</div>

@if (showFam)
{
    <div style="display:flex; flex-wrap:wrap; gap:20px; margin-top:20px; justify-content:center;">
        <!-- Fam Images -->
        <img src="/image/ALBUM6.jpg" style="width:200px; height:200px; object-fit:cover; border-radius:10px;" />
        <img src="/image/FAM1.jpg" style="width:200px; height:200px; object-fit:cover; border-radius:10px;" />
        <img src="/image/FAM2.jpg" style="width:200px; height:200px; object-fit:cover; border-radius:10px;" />
        <img src="/image/FAM3.jpg" style="width:200px; height:200px; object-fit:cover; border-radius:10px;" />
    </div>
}

<!-- Screenshots Section -->
<div style="background-color:lavender; color:#333; padding:20px; border-radius:10px;
            display:flex; align-items:center; justify-content:space-between; width:400px; margin-top:20px;">
    <img src="image/Screenshot1.jpg"
         style="width:60px; height:60px; border-radius:50%; border:2px solid white;" />

    <div style="flex-grow:1; text-align:center;">
        <p style="margin:0; font-size:1.2rem;">SCREENSHOTS</p>
    </div>

    <button class="btn btn-primary" @onclick="ToggleScreenshots">...</button>
</div>

@if (showScreenshots)
{
    <div style="display:flex; flex-wrap:wrap; gap:20px; margin-top:20px; justify-content:center;">
        <!-- Screenshot Images -->
        <img src="/image/Screenshot1.jpg" style="width:200px; height:200px; object-fit:cover; border-radius:10px;" />
        <img src="/image/Screenshot2.jpg" style="width:200px; height:200px; object-fit:cover; border-radius:10px;" />
        <img src="/image/Screenshot3.jpg" style="width:200px; height:200px; object-fit:cover; border-radius:10px;" />
    </div>
}

<!-- Qupals Section -->
<div style="background-color:peachpuff; color:#333; padding:20px; border-radius:10px;
            display:flex; align-items:center; justify-content:space-between; width:400px; margin-top:20px;">
    <img src="image/QUPALS1.jpeg"
         style="width:60px; height:60px; border-radius:50%; border:2px solid white;" />

    <div style="flex-grow:1; text-align:center;">
        <p style="margin:0; font-size:1.2rem;">QUPALS</p>
    </div>

    <button class="btn btn-primary" @onclick="ToggleQupals">...</button>
</div>

@if (showQupals)
{
    <div style="display:flex; flex-wrap:wrap; gap:20px; margin-top:20px; justify-content:center;">
        <!-- Qupals Images -->
        <img src="/image/QUPALS1.jpeg" style="width:200px; height:200px; object-fit:cover; border-radius:10px;" />
        <img src="/image/QUPALS2.jpeg" style="width:200px; height:200px; object-fit:cover; border-radius:10px;" />
    </div>
}

<!-- Animals Section -->
<div style="background-color:lightblue; color:#333; padding:20px; border-radius:10px;
            display:flex; align-items:center; justify-content:space-between; width:400px; margin-top:20px;">
    <img src="image/ANIMALS3.jpg"
         style="width:60px; height:60px; border-radius:50%; border:2px solid white;" />

    <div style="flex-grow:1; text-align:center;">
        <p style="margin:0; font-size:1.2rem;">ANIMALS</p>
    </div>

    <button class="btn btn-primary" @onclick="ToggleAnimals">...</button>
</div>

@if (showAnimals)
{
    <div style="display:flex; flex-wrap:wrap; gap:20px; margin-top:20px; justify-content:center;">
        <!-- Animal Images -->
        <img src="/image/ANIMALS3.jpg" style="width:200px; height:200px; object-fit:cover; border-radius:10px;" />
        <img src="/image/ANIMALS2.jpeg" style="width:200px; height:200px; object-fit:cover; border-radius:10px;" />
    </div>
}

@code {
    private bool showFavourite = false;
    private bool showFam = false;
    private bool showScreenshots = false;
    private bool showQupals = false;
    private bool showAnimals = false;

    private void ToggleFavourite() => showFavourite = !showFavourite;
    private void ToggleFam() => showFam = !showFam;
    private void ToggleScreenshots() => showScreenshots = !showScreenshots;
    private void ToggleQupals() => showQupals = !showQupals;
    private void ToggleAnimals() => showAnimals = !showAnimals;
}
