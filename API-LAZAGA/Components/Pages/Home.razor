@page "/"
@using System.Net.Http.Json
@using API_LAZAGA.Models
@inject HttpClient Http

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

@if (telemetryData != null)
{
    <ul>
        @foreach (var dawg in telemetryData)
        {
            <h2>@dawg.Message</h2>
            <h2>@dawg.Status</h2>
        }
    </ul>
}

@code {

    private List<DogAPI>? telemetryData;

    protected override async Task OnInitializedAsync()
    {
        string DogURL = "https://dog.ceo/api/breed/affenpinscher/images/random";
        var DogName = await Http.GetFromJsonAsync<DogAPI>(DogURL);
        if (DogName != null) telemetryData = new List<DogAPI> { DogName };
    }
}